{
  "name": "tracking-auto",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p packages/domain && tsc -p packages/card-renderer && tsc -p packages/market-data && tsc -p packages/connectors && tsc -p packages/database && tsc -p packages/reporting && tsc -p packages/shared && tsc -p apps/api && tsc -p apps/worker && tsc -p apps/screenshot-worker",
    "test": "jest",
    "postinstall": "prisma generate --schema prisma/schema.prisma"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.5",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "prisma": "6.19.3",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@prisma/client": "6.19.3",
    "bullmq": "6.3.12",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "ioredis": "6.0.0",
    "playwright": "1.64.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "teleproto": "1.230.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
