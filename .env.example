# Copy file này thành `.env` rồi điền giá trị thật. KHÔNG commit `.env`.
# `.env.example` chỉ chứa placeholder — không điền secret thật vào đây.
#
# Quy ước trong file này:
#   VAR=            -> BẮT BUỘC điền (tính năng chết nếu thiếu, báo lỗi rõ ràng)
#   VAR=giá-trị     -> Có default trong code, giữ nguyên nếu không cần đổi
#   # VAR=...       -> Tham khảo, bỏ comment khi cần (để comment thì code dùng default)

# --- Telegram collection (teleproto / USER_SESSION) ---
# Lấy tại https://my.telegram.org (API development tools)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# StringSession sau login lần đầu (client.session.save()), lưu mã hóa
TELEGRAM_SESSION_STRING=

# --- Telegram reporting + operator bot (BOT sender) ---
# Token bot từ @BotFather; bot phải là admin có quyền post ở channel đích
TELEGRAM_BOT_TOKEN=

# --- Hyperliquid market data (public, no key) ---
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz

# --- Virtual paper trading ---
# Position notional is stored per coin in tradable_coins (BTC/ETH/SOL 100k, others 50k).
# Update it with the /vol bot command or /api/v1/operations/notional.
# Default virtual account id for AUTO mode (fallback: first account)
VIRTUAL_DEFAULT_ACCOUNT_ID=
# Default destination chat for auto-published cards
REPORT_DESTINATION_CHAT_ID=
# Market-watch poll interval (ms)
MARKET_POLL_MS=5000
# /pos entry market: chờ bao lâu trước khi lấy mid để vào lệnh (ms, 0..30000).
POS_MARKET_ENTRY_DELAY_MS=3000
# /pos entry market: card không render sớm hơn entry + mốc này (ms, 0..30000).
POS_MARKET_CARD_MIN_AGE_MS=3000

# --- Daily Google Sheet report ---
# Đường dẫn file JSON service account (không commit file này).
GOOGLE_SERVICE_ACCOUNT_JSON=/opt/tracking_trade/secrets/tracking-sheet.json
DAILY_SHEET_SPREADSHEET_ID=
# Tab mẫu dùng để duplicate cho từng ngày.
DAILY_SHEET_TEMPLATE_TAB=TEMPLATE
# Account virtual cần báo cáo.
DAILY_SHEET_ACCOUNT_ID=
# Ngày bắt đầu; bỏ trống = lấy ngày đầu tiên service chạy và lưu vào DB.
DAILY_SHEET_START_DATE=
DAILY_SHEET_TIMEZONE=Asia/Ho_Chi_Minh
# Reconcile mỗi 5 phút; tối thiểu 60s.
DAILY_SHEET_SYNC_MS=300000
# Giờ reconcile đầy đủ buổi sáng (HH:mm).
DAILY_SHEET_MORNING_AT=08:00
# TP/SL settle: chờ card render + reply tối đa bao lâu rồi vẫn đóng lệnh (ms).
# Quá hạn thì đóng với giá đóng băng và để card tự retry đăng sau.
# SETTLE_PUBLISH_TIMEOUT_MS=60000
# Tuổi tối đa của approval (giờ); quá hạn phải approve lại
# SIGNAL_MAX_AGE_HOURS=24

# --- Vận hành ---
# Username Telegram (comma-separated) duy nhất có quyền approve/reject và bật/tắt kill switch
# Ví dụ: OPERATOR_USERNAMES=alice,bob
OPERATOR_USERNAMES=
# Chat ID Telegram của từng operator (comma-separated) để bot DM review/alert thẳng.
# Lấy bằng cách forward 1 tin nhắn bất kỳ cho @userinfobot. Mỗi operator phải
# nhắn /start cho bot 1 lần, nếu không Telegram chặn DM từ bot.
# Ví dụ: OPERATOR_CHAT_IDS=123456789,987654321
OPERATOR_CHAT_IDS=
# Bật bot Telegram ở process API (bot chạy chung backend, 1 poller duy nhất).
# Trong docker, compose đã bật sẵn cho service api và ép worker=false.
# Bật ở đây để `npm run dev` local cũng host bot.
# OPERATOR_BOT_ENABLED=true
# Chat ID nhận cảnh báo vận hành (backup fail, deploy notify)
ALERT_CHAT_ID=

# --- Hạ tầng ---
# CHÚ Ý: để trống/comment 2 dòng dưới khi chạy local ngoài docker thì code
# tự dùng default (postgres localhost:5434, redis localhost:6379).
# Trên VPS, docker-compose.prod.yml đã đè URL nội bộ nên không cần điền.
# Bỏ comment và điền khi DB/Redis ở host khác:
# DATABASE_URL=postgresql://tracking:tracking@localhost:5434/tracking
# REDIS_URL=redis://localhost:6379
# Thư mục lưu ảnh card P&L (local volume; mặc định ./artifacts)
ARTIFACTS_DIR=
# Port API khi chạy local ngoài docker (compose đã set 3000, không cần điền)
# PORT=3000

# Card render consumer runs inside the API (default true). Set false on HTTP-only replicas.
# RENDER_WORKER_ENABLED=true
