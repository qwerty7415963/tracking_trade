# Copy file này thành `.env` rồi điền giá trị thật. KHÔNG commit `.env`.
# `.env.example` chỉ chứa placeholder — không điền secret thật vào đây.

# --- Telegram collection (teleproto / USER_SESSION) ---
# Lấy tại https://my.telegram.org (API development tools)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# StringSession sau login lần đầu (client.session.save()), lưu mã hóa
TELEGRAM_SESSION_STRING=

# --- Telegram reporting (BOT sender) ---
# Token bot từ @BotFather; bot phải là admin có quyền post ở channel đích
TELEGRAM_BOT_TOKEN=

# --- X connector (Playwright) ---
# Đường dẫn file storage-state của Playwright (tránh lưu password plaintext)
X_SESSION_STATE_PATH=

# --- Hyperliquid market data (public, no key) ---
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz

# --- Virtual paper trading ---
# USDC risk budget per new position (sized so SL hit loses this much)
RISK_BUDGET_USDC=50
# Default virtual account id for AUTO mode (fallback: first account)
VIRTUAL_DEFAULT_ACCOUNT_ID=
# Default destination chat for auto-published cards
REPORT_DESTINATION_CHAT_ID=
# Market-watch poll interval (ms)
MARKET_POLL_MS=5000

# --- Vận hành ---
# Username Telegram (comma-separated) duy nhất có quyền approve/reject và bật/tắt kill switch
# Ví dụ: OPERATOR_USERNAMES=alice,bob
OPERATOR_USERNAMES=
# Chat ID Telegram của từng operator (comma-separated) để bot DM review/alert thẳng.
# Lấy bằng cách forward 1 tin nhắn bất kỳ cho @userinfobot. Mỗi operator phải
# nhắn /start cho bot 1 lần, nếu không Telegram chặn DM từ bot.
# Ví dụ: OPERATOR_CHAT_IDS=123456789,987654321
OPERATOR_CHAT_IDS=
# Chat ID nhận cảnh báo vận hành (backup fail, bridge down...)
ALERT_CHAT_ID=

# --- Hạ tầng ---
DATABASE_URL=
REDIS_URL=
# Thư mục lưu ảnh card P&L (local volume; mặc định ./artifacts)
ARTIFACTS_DIR=
